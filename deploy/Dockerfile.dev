# Образ для локальной разработки: зависимости Python; код монтируется томом с хоста (hot-reload).
FROM python:3.14-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    libpq-dev \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

EXPOSE 8000

# --reload-dir: только backend (том монтирует весь репозиторий в /app).
CMD ["uvicorn", "backend.endpoints:app", "--reload", "--reload-dir", "/app/backend", "--host", "0.0.0.0", "--port", "8000"]
