DATABASE_URL=postgres://postgres:postgres@localhost:5432/chess
DB_GENERATE_SCHEMAS=false

# JWT (обязательно; длинная случайная строка для production)
JWT_SECRET=change-me-use-long-random-secret
JWT_EXPIRE_HOURS=168

# Имя cookie с JWT (HttpOnly)
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Сессия OAuth (state); по умолчанию совпадает с JWT_SECRET
# SESSION_SECRET=

# Анонимный режим: TTL аккаунта и JWT (часы)
ANONYMOUS_TTL_HOURS=24

# Google OAuth (опционально; без них эндпоинты /api/auth/google вернут 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# После Google OAuth — открыть приложение (корень SPA); там же подхватится cookie и покажется игра
FRONTEND_AFTER_LOGIN_URL=http://127.0.0.1:8000/

# CORS (опционально): через запятую, только если фронт на другом origin, чем API.
# Обычный dev с Vite: запросы идут на тот же origin через proxy в vite.config.js — CORS не нужен.
# Пример: CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=
